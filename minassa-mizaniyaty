                { id: 1, title: "مشكلة في تسجيل الدخول", type: "technical", priority: "high", status: "open", date: "2024-01-15", user: "أحمد محمد" },
                { id: 2, title: "استفسار حول الباقة المميزة", type: "billing", priority: "medium", status: "in-progress", date: "2024-01-14", user: "فاطمة علي" },
                { id: 3, title: "طلب ميزة جديدة", type: "feature", priority: "low", status: "resolved", date: "2024-01-10", user: "خالد إبراهيم" }
            ]
        };

        // حالة النظام
        let isAdminPanelVisible = false;
        let isSupportPanelVisible = false;

        // تهيئة التطبيق
        document.addEventListener('DOMContentLoaded', function() {
            setupAdminTabs();
            setupSupportTabs();
            loadUsersTable();
            loadSupportTickets();
            
            // إرسال إشعار ترحيب
