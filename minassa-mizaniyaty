<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام حماية وإدارة ميزانتي برو</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #2c3e50;
            --secondary: #3498db;
            --success: #27ae60;
            --warning: #f39c12;
            --danger: #e74c3c;
            --light: #ecf0f1;
            --dark: #2c3e50;
            --gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --premium: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --business: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --admin: linear-gradient(135deg, #434343 0%, #000000 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: var(--gradient);
            padding: 20px;
            min-height: 100vh;
            color: #333;
            background-attachment: fixed;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Header Styles */
        .header {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            color: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: var(--secondary);
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
        }

        .header p {
            opacity: 0.9;
            font-size: 1.1em;
        }

        /* نظام التحكم العلوي */
        .top-controls {
            position: absolute;
            top: 20px;
            width: 100%;
            display: flex;
            justify-content: space-between;
            padding: 0 20px;
        }

        .user-controls {
            display: flex;
            gap: 10px;
        }

        .language-controls {
            display: flex;
            gap: 10px;
        }

        .control-btn {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 8px;
            padding: 10px 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
            backdrop-filter: blur(5px);
        }

        .control-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .admin-badge {
            background: var(--admin);
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.8em;
            margin-left: 10px;
            font-weight: bold;
        }

        /* لوحة التحكم الإدارية */
        .admin-panel {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            display: none;
        }

        .admin-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }

        .admin-stat {
            text-align: center;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .admin-stat:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .admin-tabs {
            display: flex;
            background: white;
            border-radius: 10px;
            padding: 5px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            overflow-x: auto;
        }

        .admin-tab {
            padding: 12px 25px;
            cursor: pointer;
            border-radius: 8px;
            transition: all 0.3s ease;
            text-align: center;
            flex: 1;
            min-width: 120px;
            font-weight: 500;
        }

        .admin-tab.active {
            background: var(--secondary);
            color: white;
        }

        .admin-tab-content {
            display: none;
        }

        .admin-tab-content.active {
            display: block;
        }

        /* نظام الحماية */
        .security-panel {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .security-features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin: 20px 0;
        }

        .security-feature {
            border: 1px solid #eee;
            border-radius: 10px;
            padding: 20px;
            transition: all 0.3s ease;
        }

        .security-feature:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

        .security-status {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 10px;
        }

        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #27ae60;
        }

        .status-indicator.inactive {
            background: #e74c3c;
        }

        /* نظام الدعم الفني */
        .support-panel {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .tickets-container {
            margin: 20px 0;
        }

        .ticket {
            border: 1px solid #eee;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            transition: all 0.3s ease;
        }

        .ticket:hover {
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .ticket-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .ticket-status {
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 0.8em;
            font-weight: bold;
        }

        .status-open {
            background: #e74c3c;
            color: white;
        }

        .status-in-progress {
            background: #f39c12;
            color: white;
        }

        .status-resolved {
            background: #27ae60;
            color: white;
        }

        .ticket-meta {
            display: flex;
            gap: 15px;
            font-size: 0.9em;
            color: #666;
        }

        /* نماذج الإدخال */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 15px;
        }

        .form-group label {
            font-weight: bold;
        }

        .form-group input, .form-group textarea, .form-group select {
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 1em;
            transition: all 0.3s ease;
        }

        .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
            border-color: var(--secondary);
            box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.2);
            outline: none;
        }

        /* الأزرار */
        button {
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-save {
            background: var(--success);
            color: white;
        }

        .btn-reset {
            background: var(--danger);
            color: white;
        }

        .btn-print {
            background: var(--secondary);
            color: white;
        }

        .btn-export {
            background: var(--warning);
            color: white;
        }

        .btn-admin {
            background: var(--admin);
            color: white;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        /* الإشعارات */
        .notifications {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            max-width: 350px;
        }

        .notification {
            background: white;
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            border-right: 4px solid var(--secondary);
            display: flex;
            align-items: center;
            gap: 10px;
            transform: translateX(100%);
            opacity: 0;
            animation: slideIn 0.5s forwards;
        }

        @keyframes slideIn {
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* الجداول */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            padding: 12px 15px;
            text-align: right;
            border-bottom: 1px solid #eee;
        }

        th {
            background-color: #f8f9fa;
            font-weight: 600;
            color: var(--primary);
        }

        tr:hover {
            background-color: #f8f9fa;
        }

        /* تصميم متجاوب */
        @media (max-width: 768px) {
            .top-controls {
                flex-direction: column;
                gap: 10px;
                align-items: center;
                position: relative;
                margin-bottom: 20px;
            }
            
            .admin-stats, .security-features {
                grid-template-columns: 1fr;
            }
            
            .header h1 {
                font-size: 2em;
            }
            
            .admin-tabs {
                flex-wrap: wrap;
            }
            
            .admin-tab {
                min-width: 100px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- البانر الرئيسي -->
        <header class="header">
            <div class="top-controls">
                <div class="user-controls">
                    <button class="control-btn" onclick="showLogin()">
                        <i class="fas fa-user"></i> تسجيل الدخول
                    </button>
                    <button class="control-btn" id="adminToggleBtn" onclick="toggleAdminPanel()">
                        <i class="fas fa-cog"></i> لوحة التحكم
                    </button>
                    <button class="control-btn" onclick="showSupportPanel()">
                        <i class="fas fa-headset"></i> الدعم الفني
                    </button>
                </div>
                
                <div class="language-controls">
                    <button class="control-btn active" data-lang="ar">
                        <i class="fas fa-language"></i> العربية
                    </button>
                    <button class="control-btn" data-lang="en">
                        <i class="fas fa-language"></i> English
                    </button>
                </div>
            </div>

            <h1><i class="fas fa-shield-alt"></i> نظام حماية وإدارة ميزانتي برو</h1>
            <p>منصة متكاملة لإدارة وأمن تطبيق الميزانية مع نظام دعم فني متكامل</p>
        </header>

        <!-- لوحة تحكم المشرف -->
        <div class="admin-panel" id="adminPanel">
            <h2><i class="fas fa-tachometer-alt"></i> لوحة تحكم المشرف</h2>
            
            <div class="admin-tabs">
                <div class="admin-tab active" data-tab="dashboard">لوحة التحكم</div>
                <div class="admin-tab" data-tab="users">إدارة المستخدمين</div>
                <div class="admin-tab" data-tab="security">نظام الحماية</div>
                <div class="admin-tab" data-tab="reports">التقارير</div>
                <div class="admin-tab" data-tab="settings">الإعدادات</div>
            </div>

            <!-- تبويب لوحة التحكم -->
            <div class="admin-tab-content active" id="dashboard-tab">
                <div class="admin-stats">
                    <div class="admin-stat">
                        <h3>إجمالي المستخدمين</h3>
                        <div class="value">1,247</div>
                    </div>
                    <div class="admin-stat">
                        <h3>المشتركين المميزين</h3>
                        <div class="value">328</div>
                    </div>
                    <div class="admin-stat">
                        <h3>الإيرادات الشهرية</h3>
                        <div class="value">$8,420</div>
                    </div>
                    <div class="admin-stat">
                        <h3>نسبة التحويل</h3>
                        <div class="value">12.4%</div>
                    </div>
                    <div class="admin-stat">
                        <h3>تذاكر الدعم المفتوحة</h3>
                        <div class="value">14</div>
                    </div>
                    <div class="admin-stat">
                        <h3>حالة النظام</h3>
                        <div class="value">مستقر <i class="fas fa-check-circle" style="color: #27ae60;"></i></div>
                    </div>
                </div>
                
                <div class="security-panel">
                    <h3><i class="fas fa-shield-alt"></i> نظرة عامة على الأمن</h3>
                    <div class="security-features">
                        <div class="security-feature">
                            <h4>نظام كشف الاختراق</h4>
                            <p>يراقب النظام محاولات الوصول غير المصرح بها</p>
                            <div class="security-status">
                                <div class="status-indicator"></div>
                                <span>نشط</span>
                            </div>
                        </div>
                        <div class="security-feature">
                            <h4>جدار الحماية</h4>
                            <p>يمنع الوصول غير المصرح به إلى البيانات</p>
                            <div class="security-status">
                                <div class="status-indicator"></div>
                                <span>نشط</span>
                            </div>
                        </div>
                        <div class="security-feature">
                            <h4>التشفير</h4>
                            <p>جميع البيانات مشفرة باستخدام AES-256</p>
                            <div class="security-status">
                                <div class="status-indicator"></div>
                                <span>نشط</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="btn-group">
                    <button class="btn-save" onclick="generateSystemReport()">
                        <i class="fas fa-file-alt"></i> تقرير النظام
                    </button>
                    <button class="btn-export" onclick="exportSystemData()">
                        <i class="fas fa-download"></i> تصدير البيانات
                    </button>
                    <button class="btn-admin" onclick="sendAdminNotification()">
                        <i class="fas fa-bell"></i> إشعار للمستخدمين
                    </button>
                </div>
            </div>

            <!-- تبويب إدارة المستخدمين -->
            <div class="admin-tab-content" id="users-tab">
                <h3><i class="fas fa-users"></i> إدارة المستخدمين</h3>
                
                <div class="form-group">
                    <input type="text" id="userSearch" placeholder="البحث عن مستخدم...">
                </div>
                
                <table>
                    <thead>
                        <tr>
                            <th>اسم المستخدم</th>
                            <th>البريد الإلكتروني</th>
                            <th>نوع الاشتراك</th>
                            <th>تاريخ التسجيل</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="usersTable">
                        <!-- سيتم ملء البيانات ديناميكياً -->
                    </tbody>
                </table>
                
                <div class="btn-group" style="margin-top: 20px;">
                    <button class="btn-save" onclick="addNewUser()">
                        <i class="fas fa-user-plus"></i> إضافة مستخدم
                    </button>
                    <button class="btn-export" onclick="exportUsersData()">
                        <i class="fas fa-download"></i> تصدير بيانات المستخدمين
                    </button>
                </div>
            </div>

            <!-- تبويب نظام الحماية -->
            <div class="admin-tab-content" id="security-tab">
                <h3><i class="fas fa-shield-alt"></i> نظام الحماية المتقدم</h3>
                
                <div class="security-features">
                    <div class="security-feature">
                        <h4>المصادقة الثنائية</h4>
                        <p>تفعيل المصادقة الثنائية لجميع المستخدمين</p>
                        <div class="security-status">
                            <div class="status-indicator"></div>
                            <span>مفعل</span>
                        </div>
                        <button class="btn-save" style="margin-top: 10px;" onclick="toggleFeature('twoFactor')">تعطيل</button>
                    </div>
                    
                    <div class="security-feature">
                        <h4>تسجيل النشاطات</h4>
                        <p>تسجيل كافة نشاطات المستخدمين والإداريين</p>
                        <div class="security-status">
                            <div class="status-indicator"></div>
                            <span>مفعل</span>
                        </div>
                        <button class="btn-save" style="margin-top: 10px;" onclick="viewActivityLog()">عرض السجلات</button>
                    </div>
                    
                    <div class="security-feature">
                        <h4>جدار الحماية</h4>
                        <p>مراقبة ومنع الهجمات الإلكترونية</p>
                        <div class="security-status">
                            <div class="status-indicator"></div>
                            <span>مفعل</span>
                        </div>
                        <button class="btn-save" style="margin-top: 10px;" onclick="configureFirewall()">تهيئة</button>
                    </div>
                    
                    <div class="security-feature">
                        <h4>فحص الثغرات</h4>
                        <p>فحص النظام بشكل دوري لاكتشاف الثغرات</p>
                        <div class="security-status">
                            <div class="status-indicator inactive"></div>
                            <span>معطل</span>
                        </div>
                        <button class="btn-save" style="margin-top: 10px;" onclick="runVulnerabilityScan()">تشغيل الفحص</button>
                    </div>
                    
                    <div class="security-feature">
                        <h4>نسخ احتياطي تلقائي</h4>
                        <p>إنشاء نسخ احتياطية للبيانات بشكل دوري</p>
                        <div class="security-status">
                            <div class="status-indicator"></div>
                            <span>مفعل</span>
                        </div>
                        <button class="btn-save" style="margin-top: 10px;" onclick="createBackup()">إنشاء نسخة الآن</button>
                    </div>
                    
                    <div class="security-feature">
                        <h4>مراقبة في الوقت الحقيقي</h4>
                        <p>مراقبة النظام والتنبيه عن أي نشاط غير عادي</p>
                        <div class="security-status">
                            <div class="status-indicator"></div>
                            <span>مفعل</span>
                        </div>
                        <button class="btn-save" style="margin-top: 10px;" onclick="viewRealTimeMonitor()">عرض المراقبة</button>
                    </div>
                </div>
                
                <div class="form-group" style="margin-top: 20px;">
                    <label>البريد الإلكتروني للإشعارات الأمنية</label>
                    <input type="email" id="securityEmail" value="azou8944@gmail.com">
                    <button class="btn-save" onclick="updateSecurityEmail()">تحديث</button>
                </div>
            </div>

            <!-- تبويب التقارير -->
            <div class="admin-tab-content" id="reports-tab">
                <h3><i class="fas fa-chart-bar"></i> التقارير والإحصائيات</h3>
                
                <div class="admin-stats">
                    <div class="admin-stat" onclick="generateReport('users')">
                        <h3>تقرير المستخدمين</h3>
                        <div class="value">1,247</div>
                    </div>
                    <div class="admin-stat" onclick="generateReport('revenue')">
                        <h3>تقرير الإيرادات</h3>
                        <div class="value">$8,420</div>
                    </div>
                    <div class="admin-stat" onclick="generateReport('security')">
                        <h3>تقرير الأمن</h3>
                        <div class="value">24</div>
                    </div>
                    <div class="admin-stat" onclick="generateReport('support')">
                        <h3>تقرير الدعم</h3>
                        <div class="value">14</div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label>نوع التقرير</label>
                    <select id="reportType">
                        <option value="users">تقرير المستخدمين</option>
                        <option value="revenue">تقرير الإيرادات</option>
                        <option value="security">تقرير الأمن</option>
                        <option value="support">تقرير الدعم الفني</option>
                        <option value="system">تقرير أداء النظام</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>الفترة الزمنية</label>
                    <select id="reportPeriod">
                        <option value="today">اليوم</option>
                        <option value="week">هذا الأسبوع</option>
                        <option value="month">هذا الشهر</option>
                        <option value="quarter">هذا الربع</option>
                        <option value="year">هذه السنة</option>
                    </select>
                </div>
                
                <button class="btn-save" onclick="generateCustomReport()">
                    <i class="fas fa-file-pdf"></i> إنشاء التقرير
                </button>
                <button class="btn-export" onclick="exportReport()">
                    <i class="fas fa-download"></i> تصدير التقرير
                </button>
            </div>

            <!-- تبويب الإعدادات -->
            <div class="admin-tab-content" id="settings-tab">
                <h3><i class="fas fa-cogs"></i> إعدادات النظام</h3>
                
                <div class="form-group">
                    <label>البريد الإلكتروني للمسؤول</label>
                    <input type="email" id="adminEmail" value="azou8944@gmail.com">
                </div>
                
                <div class="form-group">
                    <label>اسم التطبيق</label>
                    <input type="text" id="appName" value="ميزانتي برو">
                </div>
                
                <div class="form-group">
                    <label>العملة الافتراضية</label>
                    <select id="defaultCurrency">
                        <option value="USD">دولار أمريكي (USD)</option>
                        <option value="EUR">يورو (EUR)</option>
                        <option value="SAR">ريال سعودي (SAR)</option>
                        <option value="AED">درهم إماراتي (AED)</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>اللغة الافتراضية</label>
                    <select id="defaultLanguage">
                        <option value="ar">العربية</option>
                        <option value="en">الإنجليزية</option>
                    </select>
                </div>
                
                <div class="form-group">
