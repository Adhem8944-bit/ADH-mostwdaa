                    toggleAdminPanel();
                } else {
                    showNotification('تم تسجيل الدخول بنجاح', 'success');
                }
                
                // إرسال إشعار بالبريد الإلكتروني عن تسجيل الدخول
                sendEmailNotification(
                    systemData.adminEmail,
                    "تسجيل دخول جديد",
                    `تم تسجيل الدخول إلى النظام باستخدام البريد الإلكتروني: ${email}`,
                    "medium"
                );
            }
        }

        // وظائف إضافية لنظام الأمان
        function viewActivityLog() {
            showNotification('جاري تحميل سجل النشاطات...', 'info');
            
            setTimeout(() => {
                alert('سجل النشاطات:\n\n- 10:15: دخول المستخدم أحمد\n- 10:20: تحديث الميزانية\n- 10:25: إنشاء تقرير جديد\n- 10:30: تسجيل خروج');
            }, 1000);
        }

        function configureFirewall() {
            showNotification('جاري فتح إعدادات جدار الحماية...', 'info');
            
            setTimeout(() => {
                alert('إعدادات جدار الحماية:\n\n- منع IPs مشبوهة: مفعل\n- مراقبة حركة البيانات: مفعل\n- كشف الهجمات: مفعل\n- تسجيل النشاط: مفعل');
            }, 1000);
        }

        function viewRealTimeMonitor() {
            showNotification('جاري تحميل مراقبة الوقت الحقيقي...', 'info');
            
            setTimeout(() => {
                alert('مراقبة الوقت الحقيقي:\n\n- حركة البيانات: طبيعية\n- استخدام الذاكرة: 65%\n- استخدام المعالج: 42%\n- اتصالات نشطة: 127\n- إنذارات أمنية: 0');
            }, 1000);
        }
    </script>
