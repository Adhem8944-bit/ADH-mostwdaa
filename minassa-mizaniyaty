        // إعداد تبويبات لوحة التحكم
        function setupAdminTabs() {
            document.querySelectorAll('.admin-tab').forEach(tab => {
                tab.addEventListener('click', function() {
                    document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
                    document.querySelectorAll('.admin-tab-content').forEach(c => c.classList.remove('active'));
                    
                    this.classList.add('active');
                    document.getElementById(`${this.dataset.tab}-tab`).classList.add('active');
                });
            });
        }

        // إعداد تبويبات الدعم الفني
        function setupSupportTabs() {
            document.querySelectorAll('.admin-tab[data-tab]').forEach(tab => {
                tab.addEventListener('click', function() {
                    if (!isSupportPanelVisible) return;
                    
                    document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
                    document.querySelectorAll('.admin-tab-content').forEach(c => c.classList.remove('active'));
                    
                    this.classList.add('active');
                    document.getElementById(`${this.dataset.tab}-tab`).classList.add('active');
                });
            });
        }

        // تبديل لوحة التحكم
        function toggleAdminPanel() {
            const adminPanel = document.getElementById('adminPanel');
            const supportPanel = document.getElementById('supportPanel');
            
            if (isAdminPanelVisible) {
                adminPanel.style.display = 'none';
                isAdminPanelVisible = false;
                document.getElementById('adminToggleBtn').innerHTML = '<i class="fas fa-cog"></i> لوحة التحكم';
            } else {
                adminPanel.style.display = 'block';
                supportPanel.style.display = 'none';
                isAdminPanelVisible = true;
                isSupportPanelVisible = false;
                document.getElementById('adminToggleBtn').innerHTML = '<i class="fas fa-times"></i> إغلاق اللوحة';
                
                // إرسال إشعار بالبريد الإلكتروني عن دخول المدير
                sendEmailNotification(
                    systemData.adminEmail,
                    "دخول إلى لوحة التحكم",
                    "تم الدخول إلى لوحة التحكم الإدارية في نظام ميزانتي برو.",
                    "high"
                );
            }
        }

        // عرض لوحة الدعم الفني
        function showSupportPanel() {
            const adminPanel = document.getElementById('adminPanel');
            const supportPanel = document.getElementById('supportPanel');
            
            if (isSupportPanelVisible) {
                supportPanel.style.display = 'none';
                isSupportPanelVisible = false;
            } else {
                supportPanel.style.display = 'block';
                adminPanel.style.display = 'none';
                isSupportPanelVisible = true;
                isAdminPanelVisible = false;
                document.getElementById('adminToggleBtn').innerHTML = '<i class="fas fa-cog"></i> لوحة التحكم';
            }
        }

        // تحميل جدول المستخدمين
        function loadUsersTable() {
            const usersTable = document.getElementById('usersTable');
            usersTable.innerHTML = '';
            
            systemData.users.forEach(user => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${user.name}</td>
                    <td>${user.email}</td>
                    <td>${user.subscription}</td>
                    <td>${user.joinDate}</td>
                    <td>${user.status === 'active' ? 'نشط' : 'غير نشط'}</td>
                    <td>
                        <button class="btn-save" onclick="editUser(${user.id})">تعديل</button>
                        <button class="btn-reset" onclick="deleteUser(${user.id})">حذف</button>
                    </td>
                `;
                usersTable.appendChild(row);
            });
        }

        // تحميل تذاكر الدعم
        function loadSupportTickets() {
            const ticketsContainer = document.getElementById('ticketsContainer');
            ticketsContainer.innerHTML = '';
            
            systemData.supportTickets.forEach(ticket => {
                const ticketElement = document.createElement('div');
                ticketElement.className = 'ticket';
                ticketElement.innerHTML = `
                    <div class="ticket-header">
                        <h4>${ticket.title}</h4>
                        <span class="ticket-status status-${ticket.status.replace('-', '')}">
                            ${ticket.status === 'open' ? 'مفتوحة' : ticket.status === 'in-progress' ? 'قيد المعالجة' : 'تم الحل'}
                        </span>
                    </div>
                    <p>${ticket.type === 'technical' ? 'مشكلة تقنية' : ticket.type === 'billing' ? 'مشكلة في الفواتير' : ticket.type === 'account' ? 'مشكلة في الحساب' : ticket.type === 'feature' ? 'طلب ميزة جديدة' : 'أخرى'}</p>
                    <div class="ticket-meta">
                        <span><i class="far fa-user"></i> ${ticket.user}</span>
                        <span><i class="far fa-calendar"></i> ${ticket.date}</span>
                        <span><i class="fas fa-flag"></i> ${ticket.priority === 'low' ? 'منخفضة' : ticket.priority === 'medium' ? 'متوسطة' : ticket.priority === 'high' ? 'عالية' : 'عاجلة'}</span>
                    </div>
                `;
                ticketsContainer.appendChild(ticketElement);
            });
        }

        // إرسال تذكرة دعم جديدة
        function submitSupportTicket() {
            const issueType = document.getElementById('issueType').value;
            const issueTitle = document.getElementById('issueTitle').value;
            const issueDescription = document.getElementById('issueDescription').value;
            const issuePriority = document.getElementById('issuePriority').value;
            
            if (!issueTitle || !issueDescription) {
                showNotification('يرجى ملء جميع الحقول المطلوبة', 'error');
                return;
            }
            
            // إضافة التذكرة الجديدة
            const newTicket = {
                id: systemData.supportTickets.length + 1,
                title: issueTitle,
                type: issueType,
                priority: issuePriority,
                status: 'open',
                date: new Date().toISOString().split('T')[0],
                user: 'مستخدم جديد'
            };
            
            systemData.supportTickets.unshift(newTicket);
            loadSupportTickets();
            
            // إرسال إشعار بالبريد الإلكتروني
            sendEmailNotification(
                systemData.adminEmail,
                "تذكرة دعم جديدة",
                `تم إنشاء تذكرة دعم جديدة:\n\nالعنوان: ${issueTitle}\nالنوع: ${issueType}\nالأولوية: ${issuePriority}\nالوصف: ${issueDescription}`,
                issuePriority
            );
            
            showNotification('تم إرسال تذكرتك بنجاح، سنقوم بالرد في أقرب وقت', 'success');
            
            // مسح النموذج
            document.getElementById('issueTitle').value = '';
            document.getElementById('issueDescription').value = '';
        }

        // إرسال إشعار بالبريد الإلكتروني
        function sendEmailNotification(to, subject, message, priority = 'medium') {
            // في التطبيق الحقيقي، هنا نستخدم خدمة إرسال البريد الإلكتروني
            console.log(`إشعار بريد إلكتروني:\nإلى: ${to}\nالموضوع: ${subject}\nالأولوية: ${priority}\nالرسالة: ${message}`);
            
            // إظهار إشعار في الواجهة
            showNotification(`تم إرسال إشعار بالبريد الإلكتروني إلى ${to}`, 'success');
        }

        // تبديل ميزة الأمان
        function toggleFeature(feature) {
            systemData.security[feature] = !systemData.security[feature];
            
            // تحديث الواجهة
            const statusIndicator = document.querySelector(`[onclick="toggleFeature('${feature}')"]`).parentElement.querySelector('.status-indicator');
            const statusText = document.querySelector(`[onclick="toggleFeature('${feature}')"]`).parentElement.querySelector('span');
            const button = document.querySelector(`[onclick="toggleFeature('${feature}')"]`);
            
            if (systemData.security[feature]) {
                statusIndicator.classList.remove('inactive');
                statusText.textContent = 'مفعل';
                button.textContent = 'تعطيل';
            } else {
                statusIndicator.classList.add('inactive');
                statusText.textContent = 'معطل';
                button.textContent = 'تفعيل';
            }
            
            // إرسال إشعار بالبريد الإلكتروني عن التغيير
            sendEmailNotification(
                systemData.adminEmail,
                `تغيير في إعدادات الأمان - ${feature}`,
                `تم ${systemData.security[feature] ? 'تفعيل' : 'تعطيل'} الميزة الأمنية: ${feature}`,
                'high'
            );
            
            showNotification(`تم ${systemData.security[feature] ? 'تفعيل' : 'تعطيل'} ${feature}`, 'success');
        }

        // إنشاء نسخة احتياطية
