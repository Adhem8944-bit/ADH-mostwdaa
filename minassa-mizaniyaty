                { id: 2, name: "فاطمة علي", email: "fatima@example.com", subscription: "free", joinDate: "2023-07-22", status: "active" },
                { id: 3, name: "خالد إبراهيم", email: "khaled@example.com", subscription: "business", joinDate: "2023-09-10", status: "active" },
